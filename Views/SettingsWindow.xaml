<Window x:Class="NimCap.Screenshot.Views.SettingsWindow" Style="{StaticResource AppWindow}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="http://wpflocalizeextension.codeplex.com"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:NimCapSettings}" Width="960" Height="720" MinWidth="640" MinHeight="420"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources><ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsStyles.xaml" /></ResourceDictionary.MergedDictionaries>
    <DataTemplate x:Key="ModelDownloadSourceSelector">
      <Border Style="{StaticResource SettingsSection}"><StackPanel>
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ModelDownloadSource}" Style="{StaticResource SectionTitle}" />
        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedModelDownloadSource, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" IsEnabled="{Binding DownloadSourceEnabled, RelativeSource={RelativeSource AncestorType=Window}}">
          <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ModelDownloadOfficial}" Tag="Official" />
          <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ModelDownloadDomestic}" Tag="Domestic" />
        </ComboBox>
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ModelDownloadSourceHint}" Style="{StaticResource Hint}" />
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ModelPathPortabilityHint}" Style="{StaticResource Hint}" />
      </StackPanel></Border>
    </DataTemplate>
    <Style TargetType="TabItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="8,2" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabSurface" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Padding="10,8">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <icons:PackIconLucide x:Name="TabIcon" Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="TabLabel" Grid.Column="2" Text="{TemplateBinding Header}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="18" />
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ControlHoverBrush}" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ToolbarActiveBrush}" /><Setter TargetName="TabLabel" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" /><Setter TargetName="TabIcon" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" /></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HotkeyField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Width" Value="210" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="IsReadOnly" Value="True" /><Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ResourceDictionary></Window.Resources>
  <Grid x:Name="SettingsRoot" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TabControl x:Name="Categories" TabStripPlacement="Left" SelectedIndex="0" Background="Transparent" BorderThickness="0">
      <TabControl.Template><ControlTemplate TargetType="TabControl">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="188" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,18,0,12">
              <StackPanel DockPanel.Dock="Top" Margin="18,0,14,14"><TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Preferences}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="NIMCAP_SCREENSHOT" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" /></StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False" Focusable="False"><TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" VerticalAlignment="Top" /></ScrollViewer>
            </DockPanel>
          </Border>
          <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" Margin="22,20,12,8" />
        </Grid>
        <ControlTemplate.Triggers><DataTrigger Binding="{Binding CompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter TargetName="NavigationColumn" Property="Width" Value="164" /><Setter TargetName="PART_SelectedContentHost" Property="Margin" Value="14,16,8,6" /></DataTrigger></ControlTemplate.Triggers>
      </ControlTemplate></TabControl.Template>
      <TabItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:General}" Tag="Settings"><ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False"><StackPanel Margin="0,0,10,12" MaxWidth="820">
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:General}" Style="{StaticResource PageTitle}" /><TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:StartupBehaviorAndApplicationInformationChangesTake}" Style="{StaticResource Hint}" />
        <Border Style="{StaticResource SettingsSection}"><StackPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:StartupAndAppearance}" Style="{StaticResource SectionTitle}" />          <CheckBox x:Name="StartWithWindows" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:StartAutomaticallyWhenSigningInToWindows}" />
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:UsesTheSameDarkThemeAsThe}" Style="{StaticResource Hint}" />
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:InterfaceLanguage}" Margin="0,14,0,0" />
        <ComboBox x:Name="InterfaceLanguageBox" DisplayMemberPath="DisplayName" SelectedValuePath="Code" />
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:LanguageSettingHint}" Style="{StaticResource Hint}" />
        </StackPanel></Border>
        <Border Style="{StaticResource SettingsSection}"><StackPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:LocalData}" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DataFolder}" FontWeight="SemiBold" Margin="0,10" />
          <DockPanel><Button x:Name="BrowseDataDirectoryButton" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Browse}" Click="BrowseDataDirectory_Click" DockPanel.Dock="Right" Margin="10,8,0,20" VerticalAlignment="Top" /><TextBox x:Name="DataDirectory" /></DockPanel>
          <Button x:Name="DefaultDataDirectoryButton" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:UseExecutableDirectory}" Click="DefaultDataDirectory_Click" HorizontalAlignment="Left" />
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DataDirectoryHint}" Style="{StaticResource Hint}" />
          <TextBlock x:Name="ActiveDataDirectory" Style="{StaticResource Hint}" />
          <Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ModelStorageTitle}" Click="ManageModelStorage_Click" HorizontalAlignment="Left" Margin="0,0,0,12" IsEnabled="{Binding DownloadSourceEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Capture}" Tag="Camera"><ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False"><StackPanel Margin="0,0,10,12" MaxWidth="820">
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Capture}" Style="{StaticResource PageTitle}" /><TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ChooseTheCaptureMethodAndPointerBehavior}" Style="{StaticResource Hint}" />
        <Border Style="{StaticResource SettingsSection}"><StackPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureOptions}" Style="{StaticResource SectionTitle}" />          <CheckBox x:Name="IncludeCursor" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:IncludeMousePointerInScreenshots}" /><CheckBox x:Name="PreferWgcCapture" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:PreferWGCCaptureRecommended}" />
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:FallsBackToGDIWhenWGCIs}" Style="{StaticResource Hint}" />
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:OutputAndFiles}" Tag="Folder"><ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False"><StackPanel Margin="0,0,10,12" MaxWidth="820">
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:OutputAndFiles}" Style="{StaticResource PageTitle}" /><TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DefaultSaveLocationEncodingAndAutomaticSaving}" Style="{StaticResource Hint}" />
        <Border Style="{StaticResource SettingsSection}"><StackPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SaveLocation}" Style="{StaticResource SectionTitle}" />          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DefaultSaveFolder}" /><DockPanel><Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Browse}" Click="Browse_Click" DockPanel.Dock="Right" Margin="10,8,0,20" VerticalAlignment="Top" /><TextBox x:Name="SaveDirectory" /></DockPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecordingSaveFolder}" /><DockPanel><Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Browse}" Click="RecordingBrowse_Click" DockPanel.Dock="Right" Margin="10,8,0,20" VerticalAlignment="Top" /><TextBox x:Name="RecordingSaveDirectory" /></DockPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecordingSaveFolderHint}" Style="{StaticResource Hint}" />
        </StackPanel></Border>
        <Border Style="{StaticResource SettingsSection}"><StackPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:EncodingAndQuality}" Style="{StaticResource SectionTitle}" />          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DefaultOutputFormat}" /><ComboBox x:Name="OutputFormatBox" DisplayMemberPath="Name" SelectionChanged="Output_Changed" />
        <CheckBox x:Name="WebpLossless" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:UseLosslessWebP}" Checked="Output_Changed" Unchecked="Output_Changed" />
        <StackPanel x:Name="QualitySection"><DockPanel><TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:JPEGWebPLossyQuality}" /><TextBlock Text="{Binding ElementName=Quality, Path=Value, StringFormat={}{0:F0}}" HorizontalAlignment="Right" /></DockPanel><Slider x:Name="Quality" Minimum="1" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" /></StackPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource SettingsSection}"><StackPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:AutomaticSavingAndNaming}" Style="{StaticResource SectionTitle}" />          <CheckBox x:Name="AutoSaveImages" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:AutomaticallySaveCompletedCapturesSeparateFromHistory}" />
        <CheckBox x:Name="ArchiveByDate" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:OrganizeAutomaticSavesIntoYyyyMMDd}" />
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:NamingTemplate}" /><TextBox x:Name="FileNameTemplate" TextChanged="Template_Changed" />
        <TextBlock x:Name="TemplatePreview" Style="{StaticResource Hint}" /><TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SupportsDateTimeWidthHeightSeqDate}" Style="{StaticResource Hint}" />
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Pins}" Tag="Pin"><ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False"><StackPanel Margin="0,0,10,12" MaxWidth="820">
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Pins}" Style="{StaticResource PageTitle}" /><TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DefaultAppearanceAndTextStyleForNew}" Style="{StaticResource Hint}" />
        <Border Style="{StaticResource SettingsSection}"><StackPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WindowsAndSnapping}" Style="{StaticResource SectionTitle}" />          <DockPanel><TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DefaultOpacity}" /><TextBlock Text="{Binding ElementName=PinOpacity, Path=Value, StringFormat={}{0:P0}}" HorizontalAlignment="Right" /></DockPanel><Slider x:Name="PinOpacity" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" />
        <CheckBox x:Name="PinSnapToEdges" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SnapDraggedPinsToTheCurrentScreen}" />
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SnapDistanceDIPScalesWithScreenDPI}" /><TextBox x:Name="PinSnapDistance" />
        </StackPanel></Border>
        <Border Style="{StaticResource SettingsSection}"><StackPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TextLayout}" Style="{StaticResource SectionTitle}" />          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TextPinFont}" /><TextBox x:Name="TextFontFamily" />
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:FontSize1064}" /><TextBox x:Name="TextFontSize" /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Width2001200Pixels}" /><TextBox x:Name="TextWidth" /></StackPanel>
        </Grid>
        </StackPanel></Border>
        <Border Style="{StaticResource SettingsSection}"><StackPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TextAndBackgroundColors}" Style="{StaticResource SectionTitle}" />          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TextColorHEX}" /><DockPanel><Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ChooseColor}" Tag="Foreground" Click="PickColor_Click" DockPanel.Dock="Right" Margin="10,8,0,20" VerticalAlignment="Top" /><TextBox x:Name="TextForeground" /></DockPanel>
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:BackgroundColorHEX}" /><DockPanel><Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ChooseColor}" Tag="Background" Click="PickColor_Click" DockPanel.Dock="Right" Margin="10,8,0,20" VerticalAlignment="Top" /><TextBox x:Name="TextBackground" /></DockPanel>
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WheelZoomCtrlWheelOpacityRightClick}" Style="{StaticResource Hint}" />
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Recording}" Tag="Video"><ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False"><StackPanel Margin="0,0,10,12" MaxWidth="820">
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecordingDefaults}" Style="{StaticResource PageTitle}" /><TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecordingRememberOptionsHint}" Style="{StaticResource Hint}" />
        <Border Style="{StaticResource SettingsSection}"><StackPanel><TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:FirstUseSetup}" Style="{StaticResource SectionTitle}" /><Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CheckAndSetUpRecording}" Click="RecordingSetup_Click" HorizontalAlignment="Left" /><TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ChecksVCX64AndMediaFoundationMissing}" Style="{StaticResource Hint}" /></StackPanel></Border>
        <Border Style="{StaticResource SettingsSection}"><StackPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:EncodingDefaults}" Style="{StaticResource SectionTitle}" />          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DefaultFormat}" /><ComboBox x:Name="RecordingFormat"><ComboBoxItem Content="MP4" /><ComboBoxItem Content="GIF" /></ComboBox>
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:MP4FrameRateGIFUpTo15}" /><ComboBox x:Name="RecordingFps"><ComboBoxItem Content="15" /><ComboBoxItem Content="30" /><ComboBoxItem Content="60" /></ComboBox>
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Quality}" /><ComboBox x:Name="RecordingQuality"><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Smooth}" Tag="流畅" /><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Standard}" Tag="标准" /><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:High}" Tag="高清" /></ComboBox>
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CaptureEngine}" /><ComboBox x:Name="RecordingCaptureBackend"><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WGCRecommended}" Tag="WGC" /><ComboBoxItem Content="Desktop Duplication（DXGI）" Tag="DXGI" /></ComboBox>
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:MP4BitrateKbps0AutomaticCustom500}" /><TextBox x:Name="RecordingBitrate" />
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Countdown010Seconds}" /><TextBox x:Name="RecordingCountdown" />
        </StackPanel></Border>
        <Border Style="{StaticResource SettingsSection}"><StackPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:PictureAndInteraction}" Style="{StaticResource SectionTitle}" />          <CheckBox x:Name="RecordingHardware" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:PreferHardwareEncodingTrySoftwareIfInitialization}" /><CheckBox x:Name="RecordingCursor" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecordMousePointer}" /><CheckBox x:Name="RecordingClicks" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:HighlightMouseClicks}" />
          <CheckBox x:Name="RecordingSystemAudio" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecordSystemAudioWASAPILoopback}" /><CheckBox x:Name="RecordingMicrophone" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecordMicrophone}" /><CheckBox x:Name="RecordingCamera" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CameraOverlayBottomRight}" />
        </StackPanel></Border>
        <Border Style="{StaticResource SettingsSection}"><StackPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DurationAndSize}" Style="{StaticResource SectionTitle}" />          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:StopAfterRecordedSeconds0ManualMaximum}" /><TextBox x:Name="RecordingStop" />
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:GIFLongestEdge160800Pixels}" /><TextBox x:Name="RecordingGifEdge" />
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:GIFHasNoAudioAndIsLimited}" Style="{StaticResource Hint}" />
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:OCRAndRecognition}" Tag="ScanText"><ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False"><StackPanel Margin="0,0,10,12" MaxWidth="820">
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:OCRAndRecognition}" Style="{StaticResource PageTitle}" /><TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:PaddleOCRRecognizesChineseAndEnglishByDefault}" Style="{StaticResource Hint}" />
        <ContentControl ContentTemplate="{StaticResource ModelDownloadSourceSelector}" />
        <Border Style="{StaticResource SettingsSection}"><StackPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecognitionEngine}" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:LocalOCREngineNoCloudOCRAPI}" /><ComboBox x:Name="OcrBackendBox" SelectionChanged="OcrBackend_Changed"><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:RecommendedLocalONNXPaddleOCRCPUOrGPU}" Tag="PaddleOCR" /><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:OptionalLocalWindowsOCRSystemLanguagePacks}" Tag="Windows" /><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:OptionalLocalTesseract5CPU}" Tag="Tesseract" /></ComboBox>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:LocalONNXIsRecommendedForEverydayOCR}" Style="{StaticResource Hint}" />
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:OcrOnnxDevice}" /><ComboBox x:Name="OnnxDeviceBox" SelectionChanged="OnnxDevice_Changed"><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:LocalCPUCompatibilityMode}" Tag="CPU" /><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:LocalGPUDirectMLNVIDIAAMDIntel}" Tag="DirectML" /></ComboBox>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DirectMLGPUIndexDefault0Use1}" /><TextBox x:Name="OnnxGpuId" />
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DirectMLIsIncludedAndDoesNotRequire}" Style="{StaticResource Hint}" />
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:GpuCrashRisk}" Style="{StaticResource Hint}" />
          <WrapPanel><Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:PaddleOCRWebsiteAndLicense}" Tag="PaddleOCR" Click="OpenProviderWebsite_Click" /><Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:DirectMLSystemRequirements}" Tag="DirectML" Click="OpenProviderWebsite_Click" Margin="10,0,0,0" /></WrapPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:AllThreeEnginesRecognizeLocallyPaddleOCRIs}" Style="{StaticResource Hint}" />
          <WrapPanel><Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:ConfigureInstalledWindowsOCR}" Click="ConfigureWindowsOcr_Click" /><Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:InstallWindowsOCRLanguagePack}" Click="OpenLanguageSettings_Click" Margin="10,0,0,0" /></WrapPanel>
          <TextBlock x:Name="WindowsOcrStatus" Style="{StaticResource Hint}" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:WindowsManagesItsLanguagePacksConfirmInstallation}" />
        </StackPanel></Border>
        <Border Style="{StaticResource SettingsSection}"><StackPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:PaddleOCRModelsAndDictionary}" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:LocalOCRModelPackageNetworkUsedOnly}" />
          <ComboBox x:Name="OcrModelPackage" SelectedValuePath="Tag">
            <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:PPOCRv6Tiny}" Tag="tiny" />
            <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:PPOCRv6SmallRecommended}" Tag="small" />
            <ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:PPOCRv6Medium}" Tag="medium" />
          </ComboBox>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SourcePPOCRv6Official}" Style="{StaticResource Hint}" />
          <WrapPanel><Button x:Name="DownloadOcrButton" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SetUpRecommendedONNXOCRDownloadModels}" Click="DownloadOcr_Click" /><Button x:Name="CancelOcrDownloadButton" Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:CancelDownload}" Click="CancelModelDownload_Click" IsEnabled="False" Margin="10,0,0,0" /></WrapPanel>
          <TextBlock x:Name="OcrDownloadStatus" Style="{StaticResource Hint}" Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:NetworkAccessOccursOnlyWhenDownloadingSave}" />
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:PaddleOCRDetectionModelDBOnnx}" /><DockPanel><Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Browse}" DockPanel.Dock="Right" Tag="OcrDetPath" Click="ModelBrowse_Click" Margin="10,8,0,20" VerticalAlignment="Top" /><TextBox x:Name="OcrDetPath" /></DockPanel>
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:PaddleOCRRecognitionModelSingleInputCTCOnnx}" /><DockPanel><Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Browse}" DockPanel.Dock="Right" Tag="OcrRecPath" Click="ModelBrowse_Click" Margin="10,8,0,20" VerticalAlignment="Top" /><TextBox x:Name="OcrRecPath" /></DockPanel>
        <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:MatchingUTF8DictionaryOneCharacterPer}" /><DockPanel><Button Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:Browse}" DockPanel.Dock="Right" Tag="OcrDictPath" Click="ModelBrowse_Click" Margin="10,8,0,20" VerticalAlignment="Top" /><TextBox x:Name="OcrDictPath" /></DockPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource SettingsSection}"><StackPanel>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:TesseractDownloadAndSetup}" Style="{StaticResource SectionTitle}" />
          <ComboBox x:Name="TesseractPackageBox" SelectedIndex="0"><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SimplifiedChineseEnglishAbout63MB}" Tag="chi_sim+eng" /><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:EnglishAbout39MB}" Tag="eng" /><ComboBoxItem Content="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:SimplifiedChineseAbout24MB}" Tag="chi_sim" /></ComboBox>
          <TextBlock Text="{loc:Loc NimCap.Screenshot.Core:Resources.Strings:PinnedOfficialTessdataFastReleaseApache2}" Style="{StaticResource Hint}" />
